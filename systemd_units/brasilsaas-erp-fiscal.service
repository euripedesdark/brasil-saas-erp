[Unit]
Description=Brasil SaaS ERP Módulo Fiscal - NF-e, NFS-e, CT-e, MDF-e, eSocial Module
After=network.target postgresql.service mongodb.service braslcloud-erp-core.service

[Service]
User=euripedes
WorkingDirectory=/home/euripedes/brasil-saas-erp
ExecStart=/usr/bin/java -jar modules/fiscal/target/brasil-saas-erp-fiscal-1.0.0-SNAPSHOT.jar --spring.profiles.active=prod
Restart=always
RestartSec=10
Environment=SPRING_PROFILES_ACTIVE=prod
Environment=JWT_SECRET=brasil-saas-erp-fiscal-ALTERE_ME_32_BYTES_OU_MAIS
Environment=MONGODB_PASSWORD=ALTERE_ME
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
