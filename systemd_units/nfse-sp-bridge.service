[Unit]
Description=Brasil SaaS NFSe SP Bridge
After=network.target

[Service]
User=euripedes
WorkingDirectory=/home/euripedes/brasil-saas-erp/src/main/resources/microservices/nfse-sp-bridge
ExecStart=/usr/bin/bundle exec ruby app.rb
Restart=always
Environment=NFSE_SP_CERT_PATH=/etc/brasil-saas/certs/sp_cert.p12
Environment=NFSE_SP_CERT_PASS=ALTERE_ME

[Install]
WantedBy=multi-user.target
