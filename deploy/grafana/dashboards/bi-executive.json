    {
      "type": "timeseries",
      "title": "Posição financeira ao longo do tempo (A receber vs A pagar)",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "bi-brasil-saas"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('month', data_vencimento)::timestamp AS time, SUM(CASE WHEN tipo='R' THEN valor_saldo ELSE 0 END) AS \"A receber\", SUM(CASE WHEN tipo='P' THEN valor_saldo ELSE 0 END) AS \"A pagar\" FROM brasil_saas_dl.v_bi_financeiro\nWHERE empresa_id = CAST('$empresa' AS bigint) AND ('financeiro') IN (SELECT unnest(string_to_array('$area', ','))) AND status='ABERTO' AND data_vencimento IS NOT NULL GROUP BY 1 ORDER BY 1",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "auto",
            "spanNulls": true,
            "gradientMode": "opacity",
            "pointSize": 6,
            "barAlignment": 0,
            "lineInterpolation": "smooth",
            "lineStyle": {
              "fill": "solid"
            },
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "date"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
