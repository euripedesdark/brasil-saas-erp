    {
      "type": "timeseries",
      "title": "Posição financeira ao longo do tempo (A receber vs A pagar)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "bi-brasil-saas"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('month', data_vencimento)::date AS time, SUM(CASE WHEN tipo='R' THEN valor_saldo ELSE 0 END) AS \"A receber\", SUM(CASE WHEN tipo='P' THEN valor_saldo ELSE 0 END) AS \"A pagar\" FROM brasil_saas_dl.v_bi_financeiro WHERE status='ABERTO' AND data_vencimento IS NOT NULL GROUP BY 1 ORDER BY 1",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "auto",
            "spanNulls": true,
            "gradientMode": "opacity",
            "pointSize": 6,
            "barAlignment": 0,
            "lineInterpolation": "smooth",
            "lineStyle": {
              "fill": "solid"
            },
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
