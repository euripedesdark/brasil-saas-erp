# Modelo isolado para /etc/brasil-saas/staging.env.
# Nao usar URLs publicas nem credenciais de producao neste ambiente.
DB_URL=jdbc:postgresql://127.0.0.1:5432/brasil-saas-staging
DB_USER=brasil-saas-staging
DB_PASSWORD=DEFINIR_CREDENCIAL_EXCLUSIVA_DO_STAGING
MONGODB_URI=mongodb://127.0.0.1:27017/brasil-saas-staging
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USER=brasil-saas-staging
RABBIT_PASSWORD=DEFINIR_CREDENCIAL_EXCLUSIVA_DO_STAGING
RABBIT_VHOST=/staging
MINIO_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=DEFINIR_ACCESS_KEY_EXCLUSIVA_DO_STAGING
MINIO_SECRET_KEY=DEFINIR_SECRET_KEY_EXCLUSIVA_DO_STAGING
MINIO_BUCKET=brasil-saas-staging
JWT_SECRET=DEFINIR_CHAVE_JWT_EXCLUSIVA_DO_STAGING
SERVER_PORT=18081
DB_POOL_MAX=3
DB_POOL_MIN=1
BRASIL_SAAS_AUTH_SERVICE_ENABLED=false
BRASIL_SAAS_AUTH_SERVICE_URL=http://127.0.0.1:8181
BRASIL_SAAS_AD_ENABLED=false
STRIPE_SUCCESS_URL=http://localhost:18081/financeiro/stripe/sucesso?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:18081/financeiro/stripe/cancelado
