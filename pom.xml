<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parent – Spring Boot 3.5 (atualizacoes de seguranca) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>br.com.brasil_saas</groupId>
    <artifactId>brasil-saas-erp</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Brasil SaaS ERP</name>
    <description>ERP brasileiro cloud-native, multiempresa, com IA assistiva nativa</description>

    <!-- =============== VERSION PROPERTIES =============== -->
    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Bibliotecas externas -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <!--
            Lombok 1.18.34 quebra ao compilar com o JDK 21.0.12.1 (o Oracle RPM
            do DC, build 18/08/2026). O stack trace e' :

                ExceptionInInitializerError
                    at lombok.javac.apt.LombokProcessor.init

            Lombok reescreve o bytecode usando as APIs INTERNAS do javac
            (com.sun.tools.javac.*), que mudam entre builds de patch do JDK. Um
            Lombok mais antigo que o javac que o executa aborta o compilador
            inteiro — e o Maven so reporta 'Fatal error compiling', sem nenhuma
            linha de .java, que e' o que torna o erro confuso.

            O notebook compila com 21.0.12 (build 21/07/2026), que o 1.18.34
            ainda alcanca. O DC tem o build de 18/08, um mes mais novo, e o
            1.18.34 nao alcanca.

            A correcao e' subir o Lombok, e nao rebaixar o JDK: um Lombok novo
            funciona nos dois JDKs, e tambem em qualquer atualizacao futura
            dele. Rebaixar o JDK prenderia o projeto a um build especifico
            enquanto a distribuicao ja oferece um mais novo.
        -->
        <lombok.version>1.18.48</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <springdoc.version>2.9.1</springdoc.version>
        <jjwt.version>0.12.6</jjwt.version>
        <flyway.version>10.17.0</flyway.version>
        <openpdf.version>3.0.5</openpdf.version>
        <pdfbox.version>3.0.3</pdfbox.version>
        <poi.version>5.3.0</poi.version>
        <jasperreports.version>6.21.5</jasperreports.version>
        <commons-beanutils.version>1.11.0</commons-beanutils.version>
        <bouncycastle.version>1.86</bouncycastle.version>
        <java-nfe.version>4.1.3</java-nfe.version>
        <!-- MDF-e, EFD e CT-e: mesma familia do java-nfe, entao a pilha de
             axis2 1.7.5, jaxb 4.0.5 e java_certificado 3.16 ja vem por
             transitiva do java-nfe e nao e preciso declarar nada disso aqui.
             As quatro ja estavam no .m2, baixadas. -->
        <!-- fincatto documentofiscal: NFe, CT-e, MDF-e, NFS-e, ECF e EFD.
             5.1.2 e a ultima RELEASE publicada. -->
        <documentofiscal.version>5.1.2</documentofiscal.version>
        <!-- A fincatto 5.1.2 declara httpclient5 5.3.1 no pom dela, mas o
             codigo chama TlsSocketStrategy, que so existe a partir da 5.4.
             Sem esta fixacao o ERP sobe e quebra no primeiro HTTPS:
             NoClassDefFoundError: org/apache/hc/client5/http/ssl/TlsSocketStrategy
             É bug do release; nao e uso errado. -->
        <httpclient5.version>5.6.4</httpclient5.version>
          <!-- O httpcore5 tem de ir junto com o client5, e o par correto e o que
               o proprio client declara: o httpclient5-parent 5.6.4 fixa
               httpcore.version 5.4.3. O 5.3.4 que estava aqui quebrava com
               NoClassDefFoundError: org/apache/hc/core5/io/IOFunction, que so
               existe a partir do core 5.4. Como o chat do Spring AI estava com
               enabled=false, a classe nunca era carregada, o erro nunca
               apareceu, e a integracao com o OpenRouter nunca tinha sido
               exercitada de verdade. -->
        <httpcore5.version>5.4.3</httpcore5.version>
        <java-efd-icms.version>3.21.1</java-efd-icms.version>
        <java-efd-contribuicoes.version>1.32.1</java-efd-contribuicoes.version>
        <java-cte.version>4.00.14</java-cte.version>
        <testcontainers.version>1.20.2</testcontainers.version>
        <pgvector.version>0.1.6</pgvector.version>
        <minio.version>8.5.12</minio.version>
        <stripe.version>34.0.0</stripe.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>commons-beanutils</groupId>
                <artifactId>commons-beanutils</artifactId>
                <version>${commons-beanutils.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- =============== DEPENDENCIES =============== -->
    <dependencies>

        <!-- ==== WEB ==== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ==== SEGURANÇA ==== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
